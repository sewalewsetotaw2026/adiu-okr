  "main": "authController.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,tsx --exec ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.build.json && npx tsc-alias -p tsconfig.build.json && cp -r src/assets dist/",
    "render-build": "npm ci --include=dev && npm run build",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "test": "node scripts/run-jest.js",
    "test:watch": "node scripts/run-jest.js --watch",
    "test:coverage": "node scripts/run-jest.js --coverage",
    "test:e2e": "jest --runInBand --testPathPatterns=e2e",
    "test:okr": "node scripts/run-jest.js okr",
    "test:okr:unit": "node scripts/run-jest.js src/tests/unit/okrMeasurementService.test.ts",
    "test:okr:e2e": "node scripts/run-jest.js src/tests/e2e/okrValidationGuards.test.ts",
    "seed:csv": "ts-node prisma/seedFromCSV.ts",
    "seed": "ts-node prisma/seed.ts",
    "seed:leave": "ts-node prisma/seedLeaveData.ts",
    "seed:kacha": "ts-node prisma/seedKachaEmployees.ts",
    "seed:adiu": "ts-node prisma/seedAdiu.ts",
    "seed:adiu-leave": "ts-node prisma/seedAdiuLeave.ts",
    "db:truncate": "ts-node scripts/truncate-db.ts",
    "seed:okr": "ts-node prisma/seedOkrData.ts"
  },
  "repository": {
    "type": "git",
